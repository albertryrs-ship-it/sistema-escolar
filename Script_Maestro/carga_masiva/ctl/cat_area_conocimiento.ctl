OPTIONS (ERRORS=0, ROWS=5000, BINDSIZE=20971520, READSIZE=20971520)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE 'datos/cat_area_conocimiento.csv'
APPEND
INTO TABLE cat_area_conocimiento
FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
  id_area,
  codigo,
  descripcion,
  activo
)
