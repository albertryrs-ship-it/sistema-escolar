OPTIONS (ERRORS=0, ROWS=5000, BINDSIZE=20971520, READSIZE=20971520)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE 'datos/mae_asignatura.csv'
APPEND
INTO TABLE mae_asignatura
FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
  id_asignatura,
  codigo,
  nombre,
  id_area,
  descripcion,
  activo
)
